<Window x:Class="ShunSeek.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ShunSeek.App.Controls"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="瞬觅 ShunSeek"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="780" Height="540"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MinWidth="600" MinHeight="400"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 标题与条目名用宋体（本机有思源宋体），说明性小字一律无衬线，10px 也不糊 -->
        <FontFamily x:Key="SerifFont">Noto Serif SC, 华文中宋, SimSun</FontFamily>
        <FontFamily x:Key="SansFont">Noto Sans SC, Microsoft YaHei UI</FontFamily>

        <!-- 墨底：上浅下沉，几乎看不出渐变，只把窗口从纯黑里托起来一点 -->
        <LinearGradientBrush x:Key="InkFill" StartPoint="0,0" EndPoint="0.45,1">
            <GradientStop Color="#FF11161A" Offset="0" />
            <GradientStop Color="#FF0E1316" Offset="0.55" />
            <GradientStop Color="#FF0B0F12" Offset="1" />
        </LinearGradientBrush>

        <!-- 朱：唯一的重色，用在焦点线、选中条、更新标记上 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC4573F" />
        <SolidColorBrush x:Key="AccentText" Color="#FFD97A5F" />
        <SolidColorBrush x:Key="TextHi" Color="#FFEDE9E1" />
        <SolidColorBrush x:Key="TextMid" Color="#FF98A3A9" />
        <SolidColorBrush x:Key="TextLow" Color="#FF69747A" />
        <SolidColorBrush x:Key="HairLine" Color="#FF1E2529" />
        <SolidColorBrush x:Key="Surface" Color="#FF161C20" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#FF1B2328" />
        <SolidColorBrush x:Key="SurfaceSel" Color="#FF1F282E" />
        <SolidColorBrush x:Key="EdgeLine" Color="#FF232B30" />
        <SolidColorBrush x:Key="EdgeStrong" Color="#FF2D373D" />

        <!-- 顶栏图标按钮：没有底，只在悬停时浮出一层极淡的墨 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextMid}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextHi}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭键：悬停转朱色，是整窗唯一的"危险色" -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC14432" />
                                <Setter Property="Foreground" Value="#FFFDF7F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFA63728" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首页磁贴：一块压进墨底的方印，悬停才亮一线边 -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ctl:LiquidPanel x:Name="Bd" Radius="12"
                                         Fill="{StaticResource Surface}"
                                         Stroke="{StaticResource EdgeLine}" StrokeThickness="1">
                            <ContentPresenter />
                        </ctl:LiquidPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="{StaticResource SurfaceHover}" />
                                <Setter TargetName="Bd" Property="Stroke" Value="{StaticResource EdgeStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="{StaticResource SurfaceSel}" />
                                <Setter TargetName="Bd" Property="Stroke" Value="#80C4573F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：不出现系统灰块箭头 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#FF2A3439" Margin="3,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 结果行：选中时左侧一道朱线，名字提亮，其余保持安静 -->
        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ctl:LiquidPanel x:Name="Bd" Radius="10" Fill="Transparent" StrokeThickness="0" />
                            <Rectangle x:Name="Mark" Width="3" Height="26" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0" />
                            <ContentPresenter Margin="18,0,12,0" />
                            <Rectangle x:Name="Rule" Height="1" VerticalAlignment="Bottom"
                                       Margin="56,0,12,0" Fill="{StaticResource HairLine}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#FF151B20" />
                                <Setter TargetName="Rule" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#FF212B32" />
                                <Setter TargetName="Bd" Property="Stroke" Value="#FF2E3A41" />
                                <Setter TargetName="Bd" Property="StrokeThickness" Value="1" />
                                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                                <Setter TargetName="Rule" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单：和窗口同一套墨色，不用系统灰白菜单 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FF151A1E" />
            <Setter Property="BorderBrush" Value="#FF252E33" />
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}" MinWidth="184">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                                                  Opacity="0.55" Color="#FF000000" />
                            </Border.Effect>
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                           FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{StaticResource AccentText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;"
                                           FontFamily="{StaticResource IconFont}" FontSize="9"
                                           Foreground="{StaticResource TextLow}"
                                           VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E272C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Padding" Value="9,6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Margin="9,5" Fill="{StaticResource HairLine}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextMid}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#FF181E22" BorderBrush="{StaticResource EdgeLine}" BorderThickness="1"
                                CornerRadius="7" Padding="9,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外面留 12px 给投影；#01000000 让这圈透明边仍然能接受拉伸/移动的命中测试 -->
    <Grid x:Name="RootLayer" Background="#01000000" Margin="12">
        <ctl:LiquidPanel x:Name="Shell" Radius="12"
                         Fill="{StaticResource InkFill}"
                         Stroke="#FF262F34" StrokeThickness="1">
            <ctl:LiquidPanel.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                  Opacity="0.55" Color="#FF000000" />
            </ctl:LiquidPanel.Effect>

            <Grid ClipToBounds="True">
                <!-- 顶部一层极淡的冷光，只让上沿比下沿亮一点点 -->
                <Rectangle IsHitTestVisible="False" Height="220" VerticalAlignment="Top" Opacity="0.5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                            <GradientStop Color="#12FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

        <Grid x:Name="RootPanel" Background="Transparent" Margin="0" MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ① 书眉：只留一个名字，右边是工具与窗口键 -->
            <Grid Grid.Row="0" Height="46" Margin="26,14,16,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="瞬觅" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource TextHi}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="{StaticResource EdgeStrong}"
                               VerticalAlignment="Center" Margin="14,0,14,0" />
                    <TextBlock Text="SHUNSEEK · 本机索引" FontFamily="{StaticResource SansFont}" FontSize="9.5"
                               Foreground="{StaticResource TextLow}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="FilterButton" Style="{StaticResource ToolButton}"
                        Click="FilterButton_Click" ToolTip="按类型筛选" VerticalAlignment="Center">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="全部" Tag="" IsCheckable="True" IsChecked="True" Click="FilterMenu_Click" />
                            <Separator />
                            <MenuItem Header="应用程序">
                                <MenuItem Header="软件" Tag="App" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="快捷方式" Tag="Shortcut" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="安装目录" Tag="InstallDir" IsCheckable="True" Click="FilterMenu_Click" />
                            </MenuItem>
                            <MenuItem Header="文件">
                                <MenuItem Header="文档" Tag="Document" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="图片" Tag="Image" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="视频" Tag="Video" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="音频" Tag="Audio" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="压缩包" Tag="Archive" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="代码" Tag="Code" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="程序" Tag="Executable" IsCheckable="True" Click="FilterMenu_Click" />
                            </MenuItem>
                            <MenuItem Header="文件夹" Tag="Folder" IsCheckable="True" Click="FilterMenu_Click" />
                            <MenuItem Header="其他" Tag="Other" IsCheckable="True" Click="FilterMenu_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ToolButton}"
                        Click="MinimizeButton_Click" ToolTip="最小化" VerticalAlignment="Center">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>

                <Button Grid.Column="3" x:Name="MaximizeButton" Style="{StaticResource ToolButton}"
                        Click="MaximizeButton_Click" ToolTip="最大化" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        <TextBlock x:Name="RestoreGlyph" Text="&#xE923;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource CloseButton}"
                        Click="CloseButton_Click" ToolTip="关闭 (Esc)" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
            </Grid>

            <!-- ② 搜索：一块沉在墨底的输入面，聚焦时左缘透出一道朱线 -->
            <ctl:LiquidPanel Grid.Row="1" Height="54" Margin="26,14,26,0" x:Name="SearchField"
                             Radius="12" Fill="{StaticResource Surface}"
                             Stroke="{StaticResource EdgeLine}" StrokeThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="FocusMark" Grid.ColumnSpan="3" Width="2" HorizontalAlignment="Left"
                               Margin="1,10,0,10" RadiusX="1" RadiusY="1"
                               Fill="{StaticResource AccentBrush}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                               FontSize="16" Foreground="{StaticResource TextLow}"
                               VerticalAlignment="Center" Margin="17,0,11,0" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Style="{x:Null}"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 FontFamily="{StaticResource SerifFont}" FontSize="17"
                                 Foreground="{StaticResource TextHi}" CaretBrush="{StaticResource AccentBrush}"
                                 VerticalContentAlignment="Center" Margin="0,0,12,0"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="Placeholder" Text="搜索文件、应用、文件夹…"
                                   FontFamily="{StaticResource SerifFont}" FontSize="16"
                                   Foreground="{StaticResource TextLow}" Margin="1,0,12,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Column="2" CornerRadius="5" Background="#FF191F23" BorderBrush="{StaticResource EdgeLine}"
                            BorderThickness="1" Padding="7,3" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Enter" FontFamily="{StaticResource SansFont}" FontSize="9.5"
                                   Foreground="{StaticResource TextLow}" />
                    </Border>
                </Grid>
            </ctl:LiquidPanel>

            <!-- ③ 一道发丝线，把书眉与正文分开 -->
            <Rectangle Grid.Row="2" Height="1" Margin="26,16,26,0" Fill="{StaticResource HairLine}" />

            <!-- ④ 正文 -->
            <Grid Grid.Row="3" Margin="26,12,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding HomeCaption}"
                           Visibility="{Binding HomeCaptionVisibility}"
                           Margin="0,0,0,10" FontFamily="{StaticResource SansFont}" FontSize="10.5"
                           Foreground="{StaticResource TextLow}" />

                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding EmptyHintText}"
                               Visibility="{Binding EmptyHintVisibility}"
                               FontFamily="{StaticResource SerifFont}" FontSize="14"
                               Foreground="{StaticResource TextLow}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                    <ListBox x:Name="ResultsList" Style="{x:Null}"
                             ItemsSource="{Binding Results}"
                             ItemContainerStyle="{StaticResource ResultRow}"
                             Visibility="{Binding ResultsVisibility}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="ResultsList_MouseDoubleClick"
                             SelectionChanged="ResultsList_SelectionChanged"
                             PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="52">
                                    <Grid Visibility="{Binding NormalVisibility}" ToolTip="{Binding Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                            <Border CornerRadius="6" Background="#FF1A2227"
                                                    Visibility="{Binding PlaceholderVisibility}" />
                                            <Image Source="{Binding Icon}" Width="24" Height="24"
                                                   Visibility="{Binding IconVisibility}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SerifFont}"
                                                       FontSize="14" Foreground="{StaticResource TextHi}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource SansFont}"
                                                       FontSize="10" Foreground="{StaticResource TextLow}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                       Foreground="#B3C4573F" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Visibility="{Binding PinVisibility}" />
                                            <Ellipse Width="5" Height="5" Fill="{Binding ImportanceBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding TypeLabel}" FontFamily="{StaticResource SansFont}"
                                                       FontSize="10" Foreground="{StaticResource TextLow}" VerticalAlignment="Center"
                                                       ToolTip="{Binding CategoryLabel}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 折叠条：同类的一堆结果压成一行 -->
                                    <Border Visibility="{Binding GroupVisibility}" CornerRadius="9"
                                            Background="#FF151D21" Margin="2,4,6,4" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                       Foreground="{StaticResource TextLow}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SerifFont}"
                                                       FontSize="12" Foreground="{StaticResource TextMid}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 首页：方印式的图标格 -->
                    <ListBox x:Name="HomeGrid" Style="{x:Null}"
                             Margin="0"
                             ItemsSource="{Binding Results}"
                             ItemContainerStyle="{StaticResource TileItem}"
                             Visibility="{Binding HomeVisibility}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="ResultsList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="170" Height="92" ToolTip="{Binding Path}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,10,0,0">
                                        <Border Width="40" Height="40" CornerRadius="10"
                                                Background="#FF1A2227"
                                                Visibility="{Binding PlaceholderVisibility}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="44" Height="44"
                                               Visibility="{Binding IconVisibility}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                                               FontFamily="{StaticResource SerifFont}" FontSize="12.5"
                                               Foreground="{StaticResource TextHi}"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="14,0,14,10" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ⑤ 页脚：索引状态、结果数、更新入口与设置 -->
            <Grid Grid.Row="4" Margin="26,10,20,14">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource HairLine}" Margin="0,0,0,0" />
                <Grid Margin="0,11,0,0">
                    <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource SansFont}" FontSize="10"
                               Foreground="{StaticResource TextLow}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" MaxWidth="340" />
                    <TextBlock Text="{Binding ResultText}" FontFamily="{StaticResource SansFont}" FontSize="10"
                               Foreground="{StaticResource TextLow}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UpdatePill" Visibility="Collapsed" Cursor="Hand"
                                Click="UpdatePill_Click" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="7" Background="#1FC4573F" Padding="9,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="可更新" FontFamily="{StaticResource SansFont}" FontSize="10"
                                                       Foreground="{StaticResource AccentText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3AC4573F" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="SettingsButton" Click="SettingsButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="7" Padding="8,4" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{StaticResource TextMid}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="设置" FontFamily="{StaticResource SansFont}" FontSize="10.5"
                                                       Foreground="{StaticResource TextMid}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
            </Grid>
        </ctl:LiquidPanel>
    </Grid>
</Window>
