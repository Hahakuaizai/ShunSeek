<ui:FluentWindow x:Class="ShunSeek.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="瞬觅 ShunSeek"
        Width="700" Height="500"
        WindowStartupLocation="Manual"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <!-- 仿 DeskBox 桌面搜索弹窗：无标题栏小窗、Mica 材质、一个输入框出全部结果。
         结构自上而下：搜索框 / 分类筛选条 / 结果列表 / 状态栏。 -->
    <ui:FluentWindow.Resources>
        <!-- 分类筛选 Chip：RadioButton 重模板成圆角胶囊，选中填充主题蓝 -->
        <Style x:Key="ChipStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="12" Padding="11,4"
                                Background="#1AFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 搜索框 -->
        <Grid Grid.Row="0" Margin="18,16,18,6">
            <ui:TextBox x:Name="SearchBox"
                        FontSize="16"
                        PlaceholderText="搜索应用、文件、文件夹…"
                        TextChanged="SearchBox_TextChanged">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                    CornerRadius="4" Background="#22FFFFFF" Padding="6,1" IsHitTestVisible="False">
                <TextBlock Text="ESC" FontSize="10" Foreground="#A8A8A8" />
            </Border>
        </Grid>

        <!-- ② 分类筛选条（Tag 与 EntryCategory 枚举名对应，全部 = 空）。
             用 WrapPanel 而不是横向 StackPanel：700 宽放不下 12 个胶囊，
             原来的写法会把后面几个直接裁掉、永远点不到。 -->
        <WrapPanel Grid.Row="1" Margin="18,4,18,4">
            <RadioButton Content="全部" Tag="" Style="{StaticResource ChipStyle}" IsChecked="True" Checked="CategoryChip_Checked" />
            <RadioButton Content="应用" Tag="App" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="快捷方式" Tag="Shortcut" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="安装目录" Tag="InstallDir" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="文件夹" Tag="Folder" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="文档" Tag="Document" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="图片" Tag="Image" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="视频" Tag="Video" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="音频" Tag="Audio" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="压缩包" Tag="Archive" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="代码" Tag="Code" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
            <RadioButton Content="程序" Tag="Executable" Style="{StaticResource ChipStyle}" Checked="CategoryChip_Checked" />
        </WrapPanel>

        <!-- ③ 结果列表（虚拟化开启：只渲染可见行，10 万条也不卡 UI） -->
        <ListBox x:Name="ResultsList"
                 Grid.Row="2"
                 Margin="10,0,10,0"
                 ItemsSource="{Binding Results}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 图标位：先用分类色块+字形。真实文件图标的异步提取缓存是阶段 4 的事，
                             接入点在 MainWindow.xaml.cs 的注释里——图标绝不能进搜索路径同步取。 -->
                        <Border Width="32" Height="32" CornerRadius="7"
                                Background="{Binding TileBackground}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TileText}" Foreground="White" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- 命中片段高亮（把命中子串加粗/变色）是阶段 4 打磨项：
                                 需要按 SearchHit.MatchStart 切三段 Run，这里先整名显示 -->
                            <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="#F2F2F2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#9A9A9A"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="8" Background="#1FFFFFFF"
                                Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" Foreground="#CFCFCF" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ④ 状态栏 -->
        <Grid Grid.Row="3" Margin="18,6,18,12">
            <!-- 左：索引状态（范围/条数/增量/最后更新时间，索引在后台更新时这行会自己变）
                 中：本次查询的命中数与耗时   右：键盘提示 -->
            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="#9A9A9A"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="330" />
            <TextBlock Text="{Binding ResultText}" FontSize="11.5" Foreground="#7FB3FF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="↑↓ 选择 · Enter 打开 · Ctrl+Enter 定位 · Ctrl+C 复制路径"
                       FontSize="11.5" Foreground="#6E6E6E"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ui:FluentWindow>
