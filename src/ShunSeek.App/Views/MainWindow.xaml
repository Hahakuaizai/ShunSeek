<ui:FluentWindow x:Class="ShunSeek.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:ShunSeek.App.Controls"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="瞬觅 ShunSeek"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="700" Height="500"
        WindowStartupLocation="Manual"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MinWidth="520" MinHeight="360"
        Topmost="True"
        Background="Transparent"
        StateChanged="Window_StateChanged">

    <!-- 液态玻璃面板：椭圆角（RadiusY > RadiusX = 连续曲率的饱满感）+ 半透明白渐变
         + 流动高光 + 沿圆角走的 1px 渐变描边。桌面透过 Mica 进来，白渐变盖在上面就是玻璃。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <ui:FluentWindow.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 圆角体系：单一半径 + 超椭圆角（squircle），同心关系 = 内角 − 内缩距离
             外框 28（内缩 0）
             控件 14（内缩约 14~18）
             磁贴 12（再缩一层） -->
        <system:Double x:Key="RadiusOuter">28</system:Double>
        <system:Double x:Key="RadiusControl">14</system:Double>
        <system:Double x:Key="RadiusTile">12</system:Double>

        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FAFCFDFF" Offset="0" />
            <GradientStop Color="#F5F3F6FA" Offset="0.55" />
            <GradientStop Color="#F2E9EEF5" Offset="1" />
        </LinearGradientBrush>

        <!-- 边缘高光：左上最亮，中段几乎透明，右下再亮一点——玻璃的厚度感 -->
        <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0.7,1">
            <GradientStop Color="#E6FFFFFF" Offset="0" />
            <GradientStop Color="#1AFFFFFF" Offset="0.3" />
            <GradientStop Color="#26FFFFFF" Offset="0.6" />
            <GradientStop Color="#B3FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InnerFill" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#FAFFFFFF" Offset="0" />
            <GradientStop Color="#E8FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.15" />
            <GradientStop Color="#8CFFFFFF" Offset="0.45" />
            <GradientStop Color="#26FFFFFF" Offset="0.55" />
            <GradientStop Color="#00FFFFFF" Offset="0.8" />
        </LinearGradientBrush>

        <!-- 顶栏/底栏的小圆角图标按钮 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#8C1D232B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F1D232B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1D232B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 磁贴：图标 + 名字，悬停/选中是玻璃上的白色蒙层 -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ctl:LiquidPanel x:Name="Bd" Radius="{StaticResource RadiusTile}"
                                         Fill="Transparent" StrokeThickness="0">
                            <ContentPresenter Margin="4,7" />
                        </ctl:LiquidPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#0F1D232B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#1A1D232B" />
                                <Setter TargetName="Bd" Property="Stroke" Value="#261D232B" />
                                <Setter TargetName="Bd" Property="StrokeThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 搜索结果行：一行一条，悬停/选中是极淡的墨色圆角 -->
        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ctl:LiquidPanel x:Name="Bd" Radius="10" Fill="Transparent" StrokeThickness="0">
                            <ContentPresenter Margin="8,0" />
                        </ctl:LiquidPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#0F1D232B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#1A1D232B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <ctl:LiquidPanel x:Name="RootPanel" Radius="{StaticResource RadiusOuter}"
                     Fill="{StaticResource GlassFill}" Stroke="{StaticResource GlassStroke}">
        <Grid>
            <!-- 面板里的柔光斑：玻璃后面透出来的颜色倾向（参考稿那三团渐变） -->
            <Ellipse Width="620" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-200,-200,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#24819BFF" Offset="0" />
                        <GradientStop Color="#00819BFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="560" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-170,-170" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1C9C8BFF" Offset="0" />
                        <GradientStop Color="#009C8BFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 极淡的冷色底：桌面太亮时，白色控件才不至于"糊"在背景里 -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#051D232B" Offset="0" />
                        <GradientStop Color="#0A1D232B" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ① 搜索栏 + 筛选 + 关闭 -->
                <Grid Grid.Row="0" Margin="22,20,18,4" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ctl:LiquidPanel Grid.Column="0" Height="46" Radius="{StaticResource RadiusControl}"
                                     Fill="{StaticResource InnerFill}" Stroke="#241D232B">
                        <ctl:LiquidPanel.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#1D232B" />
                        </ctl:LiquidPanel.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="17"
                                           Foreground="#8C1D232B" Margin="15,0,10,0" VerticalAlignment="Center" />

                            <Grid Grid.Column="1">
                                <!-- Style="{x:Null}"：WPF-UI 给 TextBox 的隐式样式会画蓝色下划线，这里外面已经有玻璃壳 -->
                                <TextBox x:Name="SearchBox" Style="{x:Null}"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         FontSize="15" Foreground="#1D232B" CaretBrush="#3B82F6"
                                         VerticalContentAlignment="Center" Margin="0,0,14,0"
                                         TextChanged="SearchBox_TextChanged" />
                                <TextBlock x:Name="Placeholder" Text="搜索文件、应用、文件夹…"
                                           FontSize="15" Foreground="#731D232B" Margin="2,0,12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </ctl:LiquidPanel>

                    <!-- 类型筛选：一个漏斗按钮 + 多级菜单 -->
                    <Button Grid.Column="1" x:Name="FilterButton" Style="{StaticResource ToolButton}"
                            Click="FilterButton_Click" ToolTip="按类型筛选">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="全部" Tag="" IsCheckable="True" IsChecked="True" Click="FilterMenu_Click" />
                                <Separator />
                                <MenuItem Header="应用程序">
                                    <MenuItem Header="软件" Tag="App" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="快捷方式" Tag="Shortcut" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="安装目录" Tag="InstallDir" IsCheckable="True" Click="FilterMenu_Click" />
                                </MenuItem>
                                <MenuItem Header="文件">
                                    <MenuItem Header="文档" Tag="Document" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="图片" Tag="Image" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="视频" Tag="Video" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="音频" Tag="Audio" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="压缩包" Tag="Archive" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="代码" Tag="Code" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="程序" Tag="Executable" IsCheckable="True" Click="FilterMenu_Click" />
                                </MenuItem>
                                <MenuItem Header="文件夹" Tag="Folder" IsCheckable="True" Click="FilterMenu_Click" />
                                <MenuItem Header="其他" Tag="Other" IsCheckable="True" Click="FilterMenu_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource ToolButton}"
                            Click="MinimizeButton_Click" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>

                    <Button Grid.Column="3" x:Name="MaximizeButton" Style="{StaticResource ToolButton}"
                            Click="MaximizeButton_Click" ToolTip="最大化">
                        <Grid>
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                            <TextBlock x:Name="RestoreGlyph" Text="&#xE923;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource ToolButton}"
                            Click="CloseButton_Click" ToolTip="关闭 (Esc)">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                    </Button>
                </Grid>

                <!-- ② 首页标题行：已固定 N · 最近使用 M -->
                <TextBlock Grid.Row="1" Text="{Binding HomeCaption}"
                           Visibility="{Binding HomeCaptionVisibility}"
                           Margin="26,10,24,0" FontSize="11.5" Foreground="#8C1D232B" />

                <!-- ③ 空状态：一句话，不铺东西 -->
                <TextBlock Grid.Row="2" Text="{Binding EmptyHintText}"
                           Visibility="{Binding EmptyHintVisibility}"
                           FontSize="13" Foreground="#661D232B"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                <!-- ④ 搜索结果：一行一条（图标 + 名称 + 路径 + 类型），一屏能看十几条 -->
                <ListBox x:Name="ResultsList" Style="{x:Null}"
                         Grid.Row="2"
                         Margin="14,6,14,0"
                         ItemsSource="{Binding Results}"
                         ItemContainerStyle="{StaticResource ResultRow}"
                         Visibility="{Binding ResultsVisibility}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         SelectionChanged="ResultsList_SelectionChanged"
                         PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="42">
                              <Grid Visibility="{Binding NormalVisibility}" ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="#141D232B"
                                            Visibility="{Binding PlaceholderVisibility}" />
                                    <Image Source="{Binding Icon}" Width="26" Height="26"
                                           Visibility="{Binding IconVisibility}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E61D232B"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="#8C1D232B"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Visibility="{Binding PinVisibility}" />
                                    <!-- 重要级圆点 + 具体类型名（Word 文档 / Python 源码 / 文件夹…） -->
                                    <Ellipse Width="6" Height="6" Fill="{Binding ImportanceBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border CornerRadius="6" Background="#0F1D232B" Padding="8,2" VerticalAlignment="Center"
                                            ToolTip="{Binding CategoryLabel}">
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" Foreground="#8C1D232B" />
                                    </Border>
                                </StackPanel>
                              </Grid>

                              <!-- 折叠条：日志/缓存/临时文件堆成一行，点一下才展开 -->
                              <Border Visibility="{Binding GroupVisibility}" CornerRadius="8"
                                      Background="#0A1D232B" Margin="0,3" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                  <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                             Foreground="#8C1D232B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                  <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#8C1D232B"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                              </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ⑤ 首页：空查询时显示图标网格（固定 + 最近） -->
                <ListBox x:Name="HomeGrid" Style="{x:Null}"
                         Grid.Row="2"
                         Margin="18,8,18,0"
                         ItemsSource="{Binding Results}"
                         ItemContainerStyle="{StaticResource TileItem}"
                         Visibility="{Binding HomeVisibility}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="152" ToolTip="{Binding Path}">
                                <Grid Height="58">
                                    <Border Width="52" Height="52" CornerRadius="13"
                                            Background="#141D232B"
                                            Visibility="{Binding PlaceholderVisibility}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Icon}" Width="56" Height="56"
                                           Visibility="{Binding IconVisibility}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="18" Height="18" CornerRadius="9"
                                            Background="#F2FFFFFF" BorderBrush="#331D232B" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,10,0"
                                            Visibility="{Binding PinVisibility}">
                                        <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="9" Foreground="#3B82F6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12.5" Foreground="#E61D232B"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ⑥ 底栏 -->
                <Grid Grid.Row="3" Margin="24,6,20,12">
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="#731D232B"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    <TextBlock Text="{Binding ResultText}" FontSize="11.5" Foreground="#8C1D232B"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <Button x:Name="SettingsButton" HorizontalAlignment="Right" Click="SettingsButton_Click"
                            Cursor="Hand" Foreground="#8C1D232B">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10" Padding="9,5" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="设置" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F1D232B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>

            <!-- 顶部内高光：贴着上边缘的一条白线，玻璃才有厚度 -->
            <Rectangle Height="1" VerticalAlignment="Top" IsHitTestVisible="False" Margin="34,1,34,0"
                       RadiusX="1" RadiusY="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#CCFFFFFF" Offset="0.28" />
                        <GradientStop Color="#CCFFFFFF" Offset="0.72" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 液态流动高光：一条斜着的白色渐变，8 秒扫一趟（参考稿的 liquid 动画） -->
            <Rectangle Width="300" IsHitTestVisible="False" Opacity="0.3"
                       Fill="{StaticResource SheenBrush}" HorizontalAlignment="Left">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="20" />
                        <TranslateTransform X="-620" Y="-140" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetProperty="RenderTransform.Children[1].X">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-620" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:4.2" Value="880" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:8" Value="880" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>
        </Grid>
    </ctl:LiquidPanel>
</ui:FluentWindow>
