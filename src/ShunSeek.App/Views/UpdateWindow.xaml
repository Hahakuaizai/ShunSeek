<Window x:Class="ShunSeek.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ShunSeek.App.Controls"
        Title="瞬觅 · 更新"
        Width="480" Height="392"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <FontFamily x:Key="SerifFont">Noto Serif SC, 华文中宋, SimSun</FontFamily>
        <FontFamily x:Key="SansFont">Noto Sans SC, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="AccentBrush" Color="#FFC4573F" />
        <SolidColorBrush x:Key="AccentText" Color="#FFD97A5F" />
        <SolidColorBrush x:Key="TextHi" Color="#FFEDE9E1" />
        <SolidColorBrush x:Key="TextMid" Color="#FF98A3A9" />
        <SolidColorBrush x:Key="TextLow" Color="#FF69747A" />
        <SolidColorBrush x:Key="HairLine" Color="#FF1E2529" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#FF1B2328" />
        <SolidColorBrush x:Key="EdgeLine" Color="#FF232B30" />

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#FF2A3439" Margin="3,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,18,18">
        <ctl:LiquidPanel x:Name="Page" Radius="14" Fill="#FF12181B"
                         Stroke="#FF2A353B" StrokeThickness="1">
            <ctl:LiquidPanel.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                                  Opacity="0.55" Color="#FF000000" />
            </ctl:LiquidPanel.Effect>

            <Grid Margin="24,18,22,16" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 书眉：一个朱色小标 + 标题，右边只留关闭 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                            Background="#26C4573F" BorderBrush="#59C4573F" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="已更新到最新版本" FontFamily="{StaticResource SerifFont}"
                                   FontSize="15" Foreground="{StaticResource TextHi}" />
                        <TextBlock Text="以下改动已在安装目录生效" FontFamily="{StaticResource SansFont}"
                                   FontSize="10" Foreground="{StaticResource TextLow}" Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Width="30" Height="28" Cursor="Hand"
                            Click="Close_Click" Foreground="{StaticResource TextMid}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 副题：时间 + 装到哪里，下面一道发丝线 -->
                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                    <TextBlock x:Name="Subtitle" FontFamily="{StaticResource SansFont}" FontSize="10"
                               Foreground="{StaticResource TextLow}" TextTrimming="CharacterEllipsis" />
                    <Rectangle Height="1" Margin="0,11,0,0" Fill="{StaticResource HairLine}" />
                </StackPanel>

                <!-- 更新条目 -->
                <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="FallbackText" FontFamily="{StaticResource SerifFont}" FontSize="12.5"
                                   Foreground="{StaticResource TextMid}" TextWrapping="Wrap" Margin="0,4,0,4" />

                        <ItemsControl x:Name="ItemsHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Top" Margin="0,7,11,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}"
                                                   FontFamily="{StaticResource SerifFont}"
                                                   FontSize="12.5" Foreground="{StaticResource TextHi}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 页脚 -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="按 Esc 关闭" FontFamily="{StaticResource SansFont}" FontSize="10"
                               Foreground="{StaticResource TextLow}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <Button HorizontalAlignment="Right" Cursor="Hand" Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="#26C4573F"
                                        BorderBrush="#66C4573F" BorderThickness="1" Padding="16,7">
                                    <TextBlock Text="知道了" FontFamily="{StaticResource SansFont}" FontSize="11"
                                               Foreground="{StaticResource TextHi}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3AC4573F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </ctl:LiquidPanel>
    </Grid>
</Window>
