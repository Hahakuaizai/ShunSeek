<Window x:Class="ShunSeek.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ShunSeek.App.Controls"
        Title="瞬觅 ShunSeek"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="780" Height="540"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MinWidth="600" MinHeight="400"
        Topmost="False"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="SerifFont">Noto Serif SC, 华文中宋, SimSun</FontFamily>
        <FontFamily x:Key="SansFont">Noto Sans SC, Microsoft YaHei UI</FontFamily>

        <!-- 顶栏图标按钮：悬停浮出一层墨/纸，120ms 淡入 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Veil" CornerRadius="8" Background="{DynamicResource SurfaceHover}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Veil" Property="Background" Value="{DynamicResource SurfaceSel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Veil" CornerRadius="8" Background="{DynamicResource CloseHover}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource CloseText}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Veil" Property="Background" Value="{DynamicResource ClosePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首页磁贴：悬停浮层 + 轻微放大，选中浮出朱边 -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ctl:LiquidPanel Radius="12" Fill="{DynamicResource Surface}"
                                             Stroke="{DynamicResource EdgeLine}" StrokeThickness="1" />
                            <ctl:LiquidPanel x:Name="HoverVeil" Radius="12" Fill="{DynamicResource SurfaceHover}"
                                             StrokeThickness="0" Opacity="0" />
                            <ctl:LiquidPanel x:Name="SelVeil" Radius="12" Fill="{DynamicResource SurfaceSel}"
                                             Stroke="{DynamicResource PillStroke}" StrokeThickness="1" Opacity="0" />
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <ContentPresenter />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.03" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.03" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelVeil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelVeil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="{DynamicResource ThumbFill}" Margin="3,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 结果行：悬停浮层淡入，选中浮出朱线与描边 -->
        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ctl:LiquidPanel Radius="10" Fill="Transparent" StrokeThickness="0" />
                            <ctl:LiquidPanel x:Name="HoverVeil" Radius="10" Fill="{DynamicResource RowHover}"
                                             StrokeThickness="0" Opacity="0" />
                            <ctl:LiquidPanel x:Name="SelVeil" Radius="10" Fill="{DynamicResource RowSel}"
                                             Stroke="{DynamicResource RowSelStroke}" StrokeThickness="1" Opacity="0" />
                            <Rectangle x:Name="Mark" Width="3" Height="26" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0" />
                            <ContentPresenter Margin="18,0,12,0" />
                            <Rectangle x:Name="Rule" Height="1" VerticalAlignment="Bottom"
                                       Margin="56,0,12,0" Fill="{DynamicResource HairLine}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Rule" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelVeil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelVeil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Rule" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 筛选芯片：单选，选中浮出朱底 + 勾 -->
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverVeil" CornerRadius="8" Background="{DynamicResource MenuHover}" Opacity="0" />
                            <ctl:LiquidPanel x:Name="SelVeil" Radius="8" Fill="{DynamicResource PillFill}"
                                             Stroke="{DynamicResource PillStroke}" StrokeThickness="1" Opacity="0" />
                            <Grid Margin="10,0,8,0">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="9" Foreground="{DynamicResource AccentText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelVeil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelVeil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单：跟窗口同一套主题色 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MenuStroke}" />
            <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}" MinWidth="184">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
                            </Border.Effect>
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Veil" CornerRadius="6" Background="{DynamicResource MenuHover}" Opacity="0" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                           FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{DynamicResource AccentText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Margin="9,5" Fill="{DynamicResource HairLine}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource TooltipFill}" BorderBrush="{DynamicResource EdgeLine}"
                                BorderThickness="1" CornerRadius="7" Padding="9,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外面留 12px 给投影；#01000000 让这圈透明边仍然能接受拉伸/移动的命中测试 -->
    <Grid x:Name="RootLayer" Background="#01000000" Margin="12">
        <ctl:LiquidPanel x:Name="Shell" Radius="12"
                         Fill="{DynamicResource InkFill}"
                         Stroke="{DynamicResource ShellStroke}" StrokeThickness="1">
            <ctl:LiquidPanel.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
            </ctl:LiquidPanel.Effect>

            <Grid ClipToBounds="True">
                <Rectangle IsHitTestVisible="False" Height="220" VerticalAlignment="Top" Opacity="0.5"
                           Fill="{DynamicResource TopGlow}" />

                <Grid x:Name="RootPanel" Background="Transparent" Margin="0" MouseLeftButtonDown="Root_MouseLeftButtonDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ① 书眉 -->
                    <Grid Grid.Row="0" Height="46" Margin="26,14,16,0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="瞬觅" FontFamily="{StaticResource SerifFont}" FontSize="22"
                                       Foreground="{DynamicResource TextHi}" VerticalAlignment="Center" />
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource EdgeStrong}"
                                       VerticalAlignment="Center" Margin="14,0,14,0" />
                            <TextBlock Text="SHUNSEEK · 本机索引" FontFamily="{StaticResource SansFont}" FontSize="9.5"
                                       Foreground="{DynamicResource TextLow}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="FilterButton" Style="{StaticResource ToolButton}"
                                Click="FilterButton_Click" ToolTip="按类型筛选" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                <Ellipse x:Name="FilterDot" Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,3,0"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="2" x:Name="ThemeButton" Style="{StaticResource ToolButton}"
                                Click="ThemeButton_Click" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeGlyph" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource ToolButton}"
                                Click="MinimizeButton_Click" ToolTip="最小化" VerticalAlignment="Center">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>

                        <Button Grid.Column="4" x:Name="MaximizeButton" Style="{StaticResource ToolButton}"
                                Click="MaximizeButton_Click" ToolTip="最大化" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                                <TextBlock x:Name="RestoreGlyph" Text="&#xE923;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="5" Style="{StaticResource CloseButton}"
                                Click="CloseButton_Click" ToolTip="退出程序" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                    </Grid>

                    <!-- ② 搜索 -->
                    <ctl:LiquidPanel Grid.Row="1" Height="54" Margin="26,14,26,0" x:Name="SearchField"
                                     Radius="12" Fill="{DynamicResource Surface}"
                                     Stroke="{DynamicResource EdgeLine}" StrokeThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="FocusMark" Grid.ColumnSpan="3" Width="2" HorizontalAlignment="Left"
                                       Margin="1,10,0,10" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                       FontSize="16" Foreground="{DynamicResource TextLow}"
                                       VerticalAlignment="Center" Margin="17,0,11,0" />

                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Style="{x:Null}"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         FontFamily="{StaticResource SerifFont}" FontSize="17"
                                         Foreground="{DynamicResource TextHi}" CaretBrush="{DynamicResource AccentBrush}"
                                         VerticalContentAlignment="Center" Margin="0,0,12,0"
                                         TextChanged="SearchBox_TextChanged" />
                                <TextBlock x:Name="Placeholder" Text="搜索文件、应用、文件夹…"
                                           FontFamily="{StaticResource SerifFont}" FontSize="16"
                                           Foreground="{DynamicResource TextLow}" Margin="1,0,12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Grid.Column="2" CornerRadius="5" Background="{DynamicResource ChipFill}"
                                    BorderBrush="{DynamicResource EdgeLine}" BorderThickness="1" Padding="7,3"
                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="Enter" FontFamily="{StaticResource SansFont}" FontSize="9.5"
                                           Foreground="{DynamicResource TextLow}" />
                            </Border>
                        </Grid>
                    </ctl:LiquidPanel>

                    <!-- ③ 发丝线 -->
                    <Rectangle Grid.Row="2" Height="1" Margin="26,16,26,0" Fill="{DynamicResource HairLine}" />

                    <!-- ④ 正文 -->
                    <Grid Grid.Row="3" Margin="26,12,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding HomeCaption}"
                                   Visibility="{Binding HomeCaptionVisibility}"
                                   Margin="0,0,0,10" FontFamily="{StaticResource SansFont}" FontSize="10.5"
                                   Foreground="{DynamicResource TextLow}" />

                        <Grid Grid.Row="1">
                            <TextBlock Text="{Binding EmptyHintText}"
                                       Visibility="{Binding EmptyHintVisibility}"
                                       FontFamily="{StaticResource SerifFont}" FontSize="14"
                                       Foreground="{DynamicResource TextLow}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                            <ListBox x:Name="ResultsList" Style="{x:Null}"
                                     ItemsSource="{Binding Results}"
                                     ItemContainerStyle="{StaticResource ResultRow}"
                                     Visibility="{Binding ResultsVisibility}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                                     SelectionChanged="ResultsList_SelectionChanged"
                                     PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="52">
                                            <Grid Visibility="{Binding NormalVisibility}" ToolTip="{Binding Path}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" Background="{DynamicResource IconPlate}"
                                                            Visibility="{Binding PlaceholderVisibility}" />
                                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                                           Visibility="{Binding IconVisibility}"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SerifFont}"
                                                               FontSize="14" Foreground="{DynamicResource TextHi}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource SansFont}"
                                                               FontSize="10" Foreground="{DynamicResource TextLow}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                               Foreground="{DynamicResource PinMark}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                               Visibility="{Binding PinVisibility}" />
                                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource ImportanceNormal}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Importance}" Value="High">
                                                                        <Setter Property="Fill" Value="{DynamicResource ImportanceHigh}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Importance}" Value="Low">
                                                                        <Setter Property="Fill" Value="{DynamicResource ImportanceLow}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding TypeLabel}" FontFamily="{StaticResource SansFont}"
                                                               FontSize="10" Foreground="{DynamicResource TextLow}" VerticalAlignment="Center"
                                                               ToolTip="{Binding CategoryLabel}" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Visibility="{Binding GroupVisibility}" CornerRadius="9"
                                                    Background="{DynamicResource FoldFill}" Margin="2,4,6,4" Padding="14,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextLow}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SerifFont}"
                                                               FontSize="12" Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox x:Name="HomeGrid" Style="{x:Null}"
                                     Margin="0"
                                     ItemsSource="{Binding Results}"
                                     ItemContainerStyle="{StaticResource TileItem}"
                                     Visibility="{Binding HomeVisibility}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                                     PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="170" Height="92" ToolTip="{Binding Path}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="54" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,10,0,0">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="{DynamicResource IconPlate}"
                                                        Visibility="{Binding PlaceholderVisibility}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="44" Height="44"
                                                       Visibility="{Binding IconVisibility}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                       FontFamily="{StaticResource SerifFont}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextHi}"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="14,0,14,10" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <!-- ⑤ 页脚 -->
                    <Grid Grid.Row="4" Margin="26,10,20,14">
                        <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource HairLine}" />
                        <Grid Margin="0,11,0,0">
                            <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource SansFont}" FontSize="10"
                                       Foreground="{DynamicResource TextLow}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis" MaxWidth="340" />
                            <TextBlock Text="{Binding ResultText}" FontFamily="{StaticResource SansFont}" FontSize="10"
                                       Foreground="{DynamicResource TextLow}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="UpdatePill" Visibility="Collapsed" Cursor="Hand"
                                        Click="UpdatePill_Click" Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border CornerRadius="7" Background="{DynamicResource PillFill}"
                                                        BorderBrush="{DynamicResource PillStroke}" BorderThickness="1" />
                                                <Border x:Name="Veil" CornerRadius="7" Background="{DynamicResource PillHover}" Opacity="0" />
                                                <StackPanel Orientation="Horizontal" Margin="9,4">
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="可更新" FontFamily="{StaticResource SansFont}" FontSize="10"
                                                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="SettingsButton" Click="SettingsButton_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="Veil" CornerRadius="7" Background="{DynamicResource SurfaceHover}" Opacity="0" />
                                                <StackPanel Orientation="Horizontal" Margin="8,4">
                                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                               Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="设置" FontFamily="{StaticResource SansFont}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ctl:LiquidPanel>

        <!-- 筛选面板：扁平芯片单选，点即生效；从按钮下方展开 -->
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" VerticalOffset="8" HorizontalOffset="-306">
            <Grid x:Name="FilterRoot" RenderTransformOrigin="1,0" Opacity="0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="FilterScale" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource MenuFill}" BorderBrush="{DynamicResource MenuStroke}"
                        BorderThickness="1" CornerRadius="12" Padding="12" Width="340">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270"
                                          Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="筛选类型" FontFamily="{StaticResource SansFont}" FontSize="11"
                                       Foreground="{DynamicResource TextLow}" VerticalAlignment="Center" />
                            <Button x:Name="FilterReset" HorizontalAlignment="Right" Click="FilterReset_Click"
                                    Cursor="Hand" Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5" Padding="6,2" Background="Transparent">
                                            <TextBlock Text="重置" FontFamily="{StaticResource SansFont}" FontSize="10.5"
                                                       Foreground="{DynamicResource AccentText}" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="FilterOptions">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="{Binding Tag}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FilterSummary" Margin="2,8,2,0" FontFamily="{StaticResource SansFont}"
                                   FontSize="10" Foreground="{DynamicResource TextLow}" Text="当前：全部类型" />
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
