<ui:FluentWindow x:Class="ShunSeek.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:ShunSeek.App.Controls"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="瞬觅 ShunSeek"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="700" Height="500"
        WindowStartupLocation="Manual"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MinWidth="520" MinHeight="360"
        Topmost="True"
        Background="Transparent"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <ui:FluentWindow.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 标题/正文用宋体（本机有思源宋体 Noto Serif SC），小字用无衬线，保证 10px 也能看清 -->
        <FontFamily x:Key="SerifFont">Noto Serif SC, 华文中宋, SimSun</FontFamily>
        <FontFamily x:Key="SansFont">Noto Sans SC, Microsoft YaHei UI</FontFamily>

        <!-- 圆角：窗口 18，卡片 12，磁贴 14 -->
        <system:Double x:Key="RadiusOuter">18</system:Double>
        <system:Double x:Key="RadiusControl">12</system:Double>
        <system:Double x:Key="RadiusTile">14</system:Double>

        <!-- 纸面：上亮下沉的暖白，中间偏暖，像被台灯斜照的一页纸 -->
        <LinearGradientBrush x:Key="PaperFill" StartPoint="0,0" EndPoint="0.2,1">
            <GradientStop Color="#FFFFFEFC" Offset="0" />
            <GradientStop Color="#FFF8FAF7" Offset="0.34" />
            <GradientStop Color="#FFF2F5F1" Offset="0.72" />
            <GradientStop Color="#FFE9EEEA" Offset="1" />
        </LinearGradientBrush>

        <!-- 纸的边：暖木色细线，而不是玻璃高光 -->
        <LinearGradientBrush x:Key="PaperStroke" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFC9D5CD" Offset="0" />
            <GradientStop Color="#FFB8C4BC" Offset="0.55" />
            <GradientStop Color="#FFA8B4AC" Offset="1" />
        </LinearGradientBrush>

        <!-- 书脊：深胡桃木色的装订条，左暗右亮的圆柱感 -->
        <LinearGradientBrush x:Key="SpineFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0E171A" Offset="0" />
            <GradientStop Color="#FF1B2A30" Offset="0.35" />
            <GradientStop Color="#FF273A41" Offset="0.72" />
            <GradientStop Color="#FF152329" Offset="1" />
        </LinearGradientBrush>

        <!-- 书脊与书页交界的那道烫金细线 -->
        <LinearGradientBrush x:Key="GiltLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#99B9CAC6" Offset="0.5" />
            <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>

        <!-- 书页堆叠的侧面：越靠外越旧 -->
        <LinearGradientBrush x:Key="EdgeFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE3D3B4" Offset="0" />
            <GradientStop Color="#FFD9C6A3" Offset="1" />
        </LinearGradientBrush>

        <!-- 输入框：比纸更白的一张标签，四边压了一道细边 -->
        <LinearGradientBrush x:Key="InnerFill" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#FFFFFFFF" Offset="0" />
            <GradientStop Color="#FFF6F9F6" Offset="1" />
        </LinearGradientBrush>

        <!-- 顶栏/底栏的小图标按钮 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9A5C6B62" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14808F8A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22808F8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首页磁贴：像一枚贴在书页上的小书签卡片 -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ctl:LiquidPanel x:Name="Bd" Radius="{StaticResource RadiusTile}"
                                         Fill="#14879C96" Stroke="#35849A94" StrokeThickness="1">
                            <ContentPresenter />
                        </ctl:LiquidPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#1F9AAFA8" />
                                <Setter TargetName="Bd" Property="Stroke" Value="#4F849A94" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#26B9CCC4" />
                                <Setter TargetName="Bd" Property="Stroke" Value="#5A849A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：书页边上不该出现系统默认的灰色方块箭头 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#336B4A2A" Margin="1,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索结果行：书页上的一条印刷行，悬停是淡淡的茶汤色，选中左侧压一道朱印 -->
        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ctl:LiquidPanel x:Name="Bd" Radius="10" Fill="Transparent" StrokeThickness="0" />
                            <Rectangle x:Name="Mark" Width="3" Height="24" RadiusX="1.5" RadiusY="1.5"
                                       Fill="#FFA63A2B" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="9,0,0,0" Opacity="0" />
                            <ContentPresenter Margin="14,0,10,0" />
                            <Rectangle x:Name="Rule" Height="1" VerticalAlignment="Bottom"
                                       Margin="44,0,10,0" Fill="#1CA8B8B0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#10808F8A" />
                                <Setter TargetName="Rule" Property="Fill" Value="#3AA8B8B0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="#1EB8C7BC" />
                                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                                <Setter TargetName="Rule" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- 最外层：三层书页叠出来的厚度在右下方露出来 -->
    <Grid x:Name="RootLayer" Background="Transparent">
        <Grid x:Name="PageStack" IsHitTestVisible="False">
            <!-- 最外一层是硬书壳，往里才是书页 -->
            <Border CornerRadius="18" Background="#FF20313A" Margin="0,0,0,0" />
            <Border CornerRadius="18" Background="#FFD9E1DC" Margin="2,2,0,0"
                    BorderBrush="#5A8A9A92" BorderThickness="1" />
            <Border CornerRadius="18" Background="#FFC6D0CB" Margin="4.5,4.5,0,0"
                    BorderBrush="#5A8A9A92" BorderThickness="1" />
            <Border CornerRadius="18" Background="#FFE0E7E3" Margin="7,7,0,0"
                    BorderBrush="#5A8A9A92" BorderThickness="1" />
        </Grid>

        <!-- 页面：Margin 右下留出 9px，让下面的页叠露边 -->
        <ctl:LiquidPanel x:Name="RootPanel" Margin="0,0,10,0"
                         Radius="{StaticResource RadiusOuter}"
                         Fill="{StaticResource PaperFill}"
                         Stroke="{StaticResource PaperStroke}" StrokeThickness="1">
            <ctl:LiquidPanel.Effect>
                <!-- 合起来的书压在桌面上的暖投影 -->
                <DropShadowEffect BlurRadius="30" ShadowDepth="7" Direction="270"
                                  Opacity="0.20" Color="#4A3320" />
            </ctl:LiquidPanel.Effect>

            <Grid ClipToBounds="True">
                <!-- 纸面顶光：靠近光源的一侧更亮 -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,0.7">
                            <GradientStop Color="#1AFFFFFF" Offset="0" />
                            <GradientStop Color="#0AFFFFFF" Offset="0.42" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 抖动噪点：8 位色深下，纯渐变会出现一条条斜带，撒一层 1px 噪点把它打散 -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,28,28"
                                      ViewportUnits="Absolute" Viewbox="0,0,28,28" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 L28,0 L28,28 L0,28 Z" />
                                    <GeometryDrawing Brush="#04FFFFFF" Geometry="M3,3 L4,3 L4,4 L3,4 Z" />
                                    <GeometryDrawing Brush="#04505F58" Geometry="M11,7 L12,7 L12,8 L11,8 Z" />
                                    <GeometryDrawing Brush="#03FFFFFF" Geometry="M19,2 L20,2 L20,3 L19,3 Z" />
                                    <GeometryDrawing Brush="#04505F58" Geometry="M25,13 L26,13 L26,14 L25,14 Z" />
                                    <GeometryDrawing Brush="#038A6A42" Geometry="M8,16 L9,16 L9,17 L8,17 Z" />
                                    <GeometryDrawing Brush="#04FFFFFF" Geometry="M16,20 L17,20 L17,21 L16,21 Z" />
                                    <GeometryDrawing Brush="#03FFFFFF" Geometry="M4,24 L5,24 L5,25 L4,25 Z" />
                                    <GeometryDrawing Brush="#04505F58" Geometry="M23,25 L24,25 L24,26 L23,26 Z" />
                                    <GeometryDrawing Brush="#038A6A42" Geometry="M13,11 L14,11 L14,12 L13,12 Z" />
                                    <GeometryDrawing Brush="#03FFFFFF" Geometry="M1,12 L2,12 L2,13 L1,13 Z" />
                                    <GeometryDrawing Brush="#04505F58" Geometry="M6,8 L7,8 L7,9 L6,9 Z" />
                                    <GeometryDrawing Brush="#04FFFFFF" Geometry="M27,6 L28,6 L28,7 L27,7 Z" />
                                    <GeometryDrawing Brush="#038A6A42" Geometry="M10,26 L11,26 L11,27 L10,27 Z" />
                                    <GeometryDrawing Brush="#038A6A42" Geometry="M17,5 L18,5 L18,6 L17,6 Z" />
                                    <GeometryDrawing Brush="#04505F58" Geometry="M2,19 L3,19 L3,20 L2,20 Z" />
                                    <GeometryDrawing Brush="#03FFFFFF" Geometry="M24,20 L25,20 L25,21 L24,21 Z" />
                                    <GeometryDrawing Brush="#04FFFFFF" Geometry="M14,27 L15,27 L15,28 L14,28 Z" />
                                    <GeometryDrawing Brush="#038A6A42" Geometry="M9,4 L10,4 L10,5 L9,5 Z" />
                                    <GeometryDrawing Brush="#038A6A42" Geometry="M26,27 L27,27 L27,28 L26,28 Z" />
                                    <GeometryDrawing Brush="#04505F58" Geometry="M0,7 L1,7 L1,8 L0,8 Z" />
                                    <GeometryDrawing Brush="#03FFFFFF" Geometry="M18,11 L19,11 L19,12 L18,12 Z" />
                                    <GeometryDrawing Brush="#04FFFFFF" Geometry="M5,13 L6,13 L6,14 L5,14 Z" />
                                    <GeometryDrawing Brush="#038A6A42" Geometry="M22,3 L23,3 L23,4 L22,4 Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 纸纤维：短而碎的细纹，密到只剩"纸"的观感 -->
                <Rectangle IsHitTestVisible="False" Opacity="0.4">                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,96,96"
                                      ViewportUnits="Absolute" Viewbox="0,0,96,96" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 L96,0 L96,96 L0,96 Z" />
                                    <GeometryDrawing Brush="#0B46564E"
                                                     Geometry="M6,11 L13,11 L13,11.9 L6,11.9 Z" />
                                    <GeometryDrawing Brush="#09607A70"
                                                     Geometry="M28,27 L34,27 L34,27.8 L28,27.8 Z" />
                                    <GeometryDrawing Brush="#0C46564E"
                                                     Geometry="M46,8 L51,8 L51,8.8 L46,8.8 Z" />
                                    <GeometryDrawing Brush="#0846564E"
                                                     Geometry="M62,41 L71,41 L71,41.8 L62,41.8 Z" />
                                    <GeometryDrawing Brush="#0B9E7A4E"
                                                     Geometry="M14,58 L20,58 L20,58.8 L14,58.8 Z" />
                                    <GeometryDrawing Brush="#096B4A2A"
                                                     Geometry="M77,19 L83,19 L83,19.8 L77,19.8 Z" />
                                    <GeometryDrawing Brush="#0B46564E"
                                                     Geometry="M84,66 L90,66 L90,66.8 L84,66.8 Z" />
                                    <GeometryDrawing Brush="#0846564E"
                                                     Geometry="M34,78 L39,78 L39,78.8 L34,78.8 Z" />
                                    <GeometryDrawing Brush="#0C607A70"
                                                     Geometry="M56,88 L64,88 L64,88.8 L56,88.8 Z" />
                                    <GeometryDrawing Brush="#096B4A2A"
                                                     Geometry="M20,92 L26,92 L26,92.8 L20,92.8 Z" />
                                    <GeometryDrawing Brush="#0B46564E"
                                                     Geometry="M90,88 L94,88 L94,88.8 L90,88.8 Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 四角压暗：纸不是平的，越往边缘越暗 -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.42,0.36" RadiusX="0.92" RadiusY="0.92">
                            <GradientStop Color="#00FFFFFF" Offset="0.5" />
                            <GradientStop Color="#0A4A5C55" Offset="0.86" />
                            <GradientStop Color="#16414F49" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 书脊：左侧一条装订木条 + 烫金细线 -->
                <Rectangle IsHitTestVisible="False" Width="18" HorizontalAlignment="Left"
                           Fill="{StaticResource SpineFill}" />
                                <Rectangle IsHitTestVisible="False" Height="6" VerticalAlignment="Top" Fill="{StaticResource SpineFill}" />
                <Rectangle IsHitTestVisible="False" Height="6" VerticalAlignment="Bottom" Fill="{StaticResource SpineFill}" />
                <Rectangle IsHitTestVisible="False" Height="1" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00B9CAC6" Offset="0" />
                            <GradientStop Color="#99B9CAC6" Offset="0.5" />
                            <GradientStop Color="#00B9CAC6" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00B9CAC6" Offset="0" />
                            <GradientStop Color="#99B9CAC6" Offset="0.5" />
                            <GradientStop Color="#00B9CAC6" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False" Width="1" HorizontalAlignment="Left" Margin="18,0,0,0"
                           Fill="{StaticResource GiltLine}" />
                <!-- 书脊挤出的阴影，让页面从装订处"陷"下去 -->
                <Rectangle IsHitTestVisible="False" HorizontalAlignment="Left" Width="38" Margin="18,0,0,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4010181B" Offset="0" />
                            <GradientStop Color="#1A10181B" Offset="0.45" />
                            <GradientStop Color="#0010181B" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Background="Transparent" Margin="18,6,0,6" MouseLeftButtonDown="Root_MouseLeftButtonDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ① 顶部书眉：朱印 + 篇名 + 窗口按钮 -->
                    <Grid Grid.Row="0" Margin="18,12,12,0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5"
                                Background="#FFA5382A" BorderBrush="#FF86291F" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="瞬" FontFamily="{StaticResource SerifFont}" FontSize="11.5"
                                       Foreground="#FFF6E7D2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="1" Text="瞬觅 · 本机索引"
                                   FontFamily="{StaticResource SerifFont}" FontSize="11.5"
                                   Foreground="#8C5E6B63" VerticalAlignment="Center" Margin="9,0,0,0" />

                        <Button Grid.Column="2" x:Name="FilterButton" Style="{StaticResource ToolButton}"
                                Click="FilterButton_Click" ToolTip="按类型筛选">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="全部" Tag="" IsCheckable="True" IsChecked="True" Click="FilterMenu_Click" />
                                    <Separator />
                                    <MenuItem Header="应用程序">
                                        <MenuItem Header="软件" Tag="App" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="快捷方式" Tag="Shortcut" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="安装目录" Tag="InstallDir" IsCheckable="True" Click="FilterMenu_Click" />
                                    </MenuItem>
                                    <MenuItem Header="文件">
                                        <MenuItem Header="文档" Tag="Document" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="图片" Tag="Image" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="视频" Tag="Video" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="音频" Tag="Audio" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="压缩包" Tag="Archive" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="代码" Tag="Code" IsCheckable="True" Click="FilterMenu_Click" />
                                        <MenuItem Header="程序" Tag="Executable" IsCheckable="True" Click="FilterMenu_Click" />
                                    </MenuItem>
                                    <MenuItem Header="文件夹" Tag="Folder" IsCheckable="True" Click="FilterMenu_Click" />
                                    <MenuItem Header="其他" Tag="Other" IsCheckable="True" Click="FilterMenu_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource ToolButton}"
                                Click="MinimizeButton_Click" ToolTip="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>

                        <Button Grid.Column="4" x:Name="MaximizeButton" Style="{StaticResource ToolButton}"
                                Click="MaximizeButton_Click" ToolTip="最大化">
                            <Grid>
                                <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                <TextBlock x:Name="RestoreGlyph" Text="&#xE923;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="5" Style="{StaticResource ToolButton}"
                                Click="CloseButton_Click" ToolTip="关闭 (Esc)">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- ② 搜索：一张贴在纸上的白标签 -->
                    <ctl:LiquidPanel Grid.Row="1" Height="44" Margin="18,9,12,0"
                                     Radius="{StaticResource RadiusControl}"
                                     Fill="{StaticResource InnerFill}" Stroke="#33A3B5AD" StrokeThickness="1">
                        <ctl:LiquidPanel.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#6E4E2C" />
                        </ctl:LiquidPanel.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="16"
                                           Foreground="#995C6B62" Margin="14,0,9,0" VerticalAlignment="Center" />

                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Style="{x:Null}"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         FontFamily="{StaticResource SerifFont}" FontSize="15"
                                         Foreground="#FF1E2622" CaretBrush="#FFA63A2B"
                                         VerticalContentAlignment="Center" Margin="0,0,14,0"
                                         TextChanged="SearchBox_TextChanged" />
                                <TextBlock x:Name="Placeholder" Text="搜索文件、应用、文件夹…"
                                           FontFamily="{StaticResource SerifFont}" FontSize="15"
                                           Foreground="#9C93A095" Margin="2,0,12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </ctl:LiquidPanel>

                    <!-- ③ 分章线：细线 + 菱形花饰 + 细线，下面再压一条更淡的线 -->
                    <Grid Grid.Row="2" Margin="18,9,12,0" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00A8B8B0" Offset="0" />
                                        <GradientStop Color="#59A8B8B0" Offset="0.45" />
                                        <GradientStop Color="#59A8B8B0" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="1" Width="5" Height="5" Fill="#66A8B8B0" Margin="10,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#59A8B8B0" Offset="0" />
                                        <GradientStop Color="#59A8B8B0" Offset="0.55" />
                                        <GradientStop Color="#00A8B8B0" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Margin="0,3,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2EA8B8B0" Offset="0" />
                                    <GradientStop Color="#19A8B8B0" Offset="0.5" />
                                    <GradientStop Color="#00A8B8B0" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <!-- ④ 正文 -->
                    <Grid Grid.Row="3" Margin="14,4,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 首页书眉：已固定 N · 最近使用 M -->
                        <TextBlock Grid.Row="0" Text="{Binding HomeCaption}"
                                   Visibility="{Binding HomeCaptionVisibility}"
                                   Margin="10,2,8,3" FontFamily="{StaticResource SansFont}" FontSize="11"
                                   Foreground="#8C5E6B63" />

                        <Grid Grid.Row="1">
                            <!-- 空状态：一句话，不铺东西 -->
                            <TextBlock Text="{Binding EmptyHintText}"
                                       Visibility="{Binding EmptyHintVisibility}"
                                       FontFamily="{StaticResource SerifFont}" FontSize="13"
                                       Foreground="#9C9AA6A0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                            <!-- 搜索结果：一行一条 -->
                            <ListBox x:Name="ResultsList" Style="{x:Null}"
                                     ItemsSource="{Binding Results}"
                                     ItemContainerStyle="{StaticResource ResultRow}"
                                     Visibility="{Binding ResultsVisibility}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                                     SelectionChanged="ResultsList_SelectionChanged"
                                     PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="45">
                                        <Grid Visibility="{Binding NormalVisibility}" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                                <Border CornerRadius="6" Background="#12808F8A"
                                                        Visibility="{Binding PlaceholderVisibility}" />
                                                <Image Source="{Binding Icon}" Width="26" Height="26"
                                                       Visibility="{Binding IconVisibility}"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SerifFont}"
                                                           FontSize="13" Foreground="#FF1F2622"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" FontFamily="{StaticResource SansFont}"
                                                           FontSize="10" Foreground="#8C5E6B63"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                           Foreground="#BF7C8F86" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding PinVisibility}" />
                                                <Ellipse Width="5" Height="5" Fill="{Binding ImportanceBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding TypeLabel}" FontFamily="{StaticResource SansFont}"
                                                           FontSize="10" Foreground="#8C5E6B63" VerticalAlignment="Center"
                                                           ToolTip="{Binding CategoryLabel}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 折叠条：同类的一堆结果压成一行 -->
                                        <Border Visibility="{Binding GroupVisibility}" CornerRadius="9"
                                                Background="#12808F8A" Margin="2,3,2,3" Padding="12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                           Foreground="#8C5E6B63" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SerifFont}"
                                                           FontSize="11.5" Foreground="#B35E6B63" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 首页：图标网格 -->
                        <ListBox x:Name="HomeGrid" Style="{x:Null}"
                                 Margin="4,0,4,0"
                                 ItemsSource="{Binding Results}"
                                 ItemContainerStyle="{StaticResource TileItem}"
                                 Visibility="{Binding HomeVisibility}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="148" Margin="3" ToolTip="{Binding Path}">
                                        <Grid Height="52">
                                            <Border Width="44" Height="44" CornerRadius="11"
                                                    Background="#12808F8A"
                                                    Visibility="{Binding PlaceholderVisibility}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="48" Height="48"
                                                   Visibility="{Binding IconVisibility}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Width="16" Height="16" CornerRadius="8"
                                                    Background="#FFF8FBF8" BorderBrush="#4A8CA6A0" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,14,0"
                                                    Visibility="{Binding PinVisibility}">
                                                <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="8" Foreground="#BF7C8F86"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource SerifFont}" FontSize="12"
                                                   Foreground="#FF1F2622"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="6,6,6,4" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Grid>

                    <!-- ⑤ 页脚 -->
                    <Grid Grid.Row="4" Margin="20,4,12,11">
                        <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource SansFont}" FontSize="10.5"
                                   Foreground="#8C5E6B63"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        <TextBlock Text="{Binding ResultText}" FontFamily="{StaticResource SansFont}" FontSize="10.5"
                                   Foreground="#8C5E6B63"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- 开发目录有更新的改动时亮出来，点一下直接编译+替换+重启 -->
                            <Button x:Name="UpdatePill" Visibility="Collapsed" Cursor="Hand"
                                    Click="UpdatePill_Click" Foreground="#FFA5382A" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="9" Background="#14A5382A" Padding="9,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="可更新" FontFamily="{StaticResource SerifFont}" FontSize="10.5"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#24A5382A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="SettingsButton" Click="SettingsButton_Click"
                                    Cursor="Hand" Foreground="#FF5E6B63">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9" Padding="8,4" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="11.5"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="设置" FontFamily="{StaticResource SerifFont}" FontSize="11.5"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#14808F8A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 页面上沿的一道极淡亮边 -->
                <Rectangle Height="1" VerticalAlignment="Top" IsHitTestVisible="False" Margin="30,1,30,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFDF6" Offset="0" />
                            <GradientStop Color="#A6FFFFFF" Offset="0.28" />
                            <GradientStop Color="#A6FFFFFF" Offset="0.72" />
                            <GradientStop Color="#00FFFDF6" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </ctl:LiquidPanel>
    </Grid>
</ui:FluentWindow>
